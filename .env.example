VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anonima-aqui

# OAuth Client ID tipo "Desktop app" — usado pelo Tauri (localhost redirect)
VITE_GOOGLE_CLIENT_ID=seu-client-id-desktop.apps.googleusercontent.com

# OAuth Client ID tipo "Web application" — usado pelo browser (ngrok, domínio, etc.)
# Deixe vazio para usar o mesmo Client ID em ambos os casos
VITE_GOOGLE_CLIENT_ID_WEB=seu-client-id-web.apps.googleusercontent.com

# GOOGLE_CLIENT_SECRET is set as a Supabase secret (server-side only):
#   supabase secrets set GOOGLE_CLIENT_ID=seu-client-id
#   supabase secrets set GOOGLE_CLIENT_SECRET=seu-client-secret
